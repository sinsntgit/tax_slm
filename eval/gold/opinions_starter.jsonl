{"id": "op14-charitable-vocational-training", "category": "research", "answer_mode": "research", "question": "A trust registered under Section 12AB runs a vocational skill-training centre for underprivileged youth and charges a nominal fee covering about 70% of operating costs, the rest funded by donations; fee receipts are INR 18 lakh for the year. Does the fee-based activity affect its exemption under Sections 11 and 12, having regard to the proviso to Section 2(15)?", "required_authorities": [{"id": "s2-15", "kind": "section", "label": "Section 2(15)", "aliases": ["Section 2(15)"], "section": "2(15)"}, {"id": "s11", "kind": "section", "label": "Section 11", "aliases": ["Section 11", "Sections 11 and 12", "Sections 11/12"], "section": "11"}, {"id": "s12", "kind": "section", "label": "Section 12", "aliases": ["Section 12", "Sections 11 and 12", "Sections 11/12", "11 and 12"], "section": "12"}, {"id": "auda", "kind": "case", "label": "ACIT (Exemptions) v. Ahmedabad Urban Development Authority (2022) 449 ITR 1 (SC)", "aliases": ["Ahmedabad Urban Development Authority", "AUDA"]}], "optional_authorities": [{"id": "s12ab", "kind": "section", "label": "Section 12AB", "aliases": ["Section 12AB"], "section": "12AB"}], "expected_key_points": [{"point": "Vocational skill training for underprivileged youth falls within the 'education' limb of Section 2(15)", "source": "OP-14 s.6", "match_any": ["education"]}, {"point": "It is not subject to the 20% commercial-receipts proviso that applies to the 'general public utility' limb", "source": "OP-14 s.6", "match_any": ["20\\s*%", "general\\s+public\\s+utility"]}, {"point": "Fees merely cover costs and there is no profit motive, so the activity is not trade, commerce or business", "source": "OP-14 s.6", "match_any": ["profit\\s+motive"]}, {"point": "The exemption under Sections 11/12 remains intact", "source": "OP-14 s.7", "match_any": ["(?:remains?|is)\\s+(?:intact|available)"]}], "must_not_claim": [{"claim": "The activity falls in
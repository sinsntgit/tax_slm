{"id": "op17-jda-45-5a", "category": "change_in_law", "answer_mode": "research", "question": "An individual holding an ancestral plot as a capital asset enters into a registered Joint Development Agreement with a developer, receiving 40% of the constructed area plus INR 50 lakh in cash; the completion certificate is expected about three years later. When does capital gains tax arise, how are the cash and constructed-area components treated, and how does this differ from the position discussed in Balbir Singh Maini?", "required_authorities": [{"id": "s45-5a", "kind": "section", "label": "Section 45(5A)", "aliases": ["Section 45(5A)"], "section": "45(5A)"}, {"id": "s194-ic", "kind": "section", "label": "Section 194-IC", "aliases": ["Section 194-IC", "194-IC", "194IC"], "section": "194-IC"}, {"id": "balbir-singh-maini", "kind": "case", "label": "CIT v. Balbir Singh Maini (2017) 398 ITR 531 (SC)", "aliases": ["Balbir Singh Maini"]}], "expected_key_points": [{"point": "Capital gains are deferred to the year the completion certificate is issued", "source": "OP-17 s.6-7", "match_any": ["completion\\s+certificate"]}, {"point": "The stamp duty value of the constructed area plus the cash consideration form the basis of the gain", "source": "OP-17 s.6", "match_any": ["stamp\\s+duty\\s+value"]}, {"point": "The developer must withhold tax under Section 194-IC on the INR 50 lakh cash at the time of payment", "source": "OP-17 s.6-7", "match_any": ["194[\\s-]?IC"]}, {"point": "Section 45(5A) supersedes the earlier possession-based trigger discussed in Balbir Singh Maini", "source": "OP-17 s.6", "match_any": ["possession"]}], "must_not_claim": [{"claim": "Taxable in the year the JDA is signed", "patterns": ["taxable\\s+in\\s+the\\s+year\\s+(?:of\\s+)?(?:entering\\s+into|execution\\s+of|signing)\\s+(?:of\\s+)?(?:the\\s+)?(?:JDA|joint\\s+development\\s+agreement)", "tax\\s+(?:arises|is\\s+payable)\\s+(?:on|when)\\s+the\\s+JDA\\s+is\\s+(?:signed|executed|entered)"]}], "sources": ["tests/fixtures/opinions/OP-17_jda_capital_gains_45_5A.md"], "notes": "DRAFT from fictitious firm opinion OP-17 - expected position is that (fictitious) opinion's conclusion, not verified law. required_authorities = frontmatter authorities the opinion's Issue/Analysis/Conclusion actually relies on; frontmatter-only authorities are optional_authorities. A tax professional must confirm the position is correct law before setting verified=true.", "optional_authorities": [], "verified_by": "claude-draft", "verified": false}
{"id": "op18-software-licence-ireland", "category": "treaty", "answer_mode": "research", "question": "An Indian company buys annual licences for enterprise software from an Irish tax resident for internal use by its IT team. The licence is non-exclusive and non-transferable, prohibits reproduction, modification and sublicensing, and transfers no copyright. Are the licence fees 'royalty' requiring withholding under Section 195, under the Act and the India-Ireland DTAA?", "required_authorities": [{"id": "s195", "kind": "section", "label": "Section 195", "aliases": ["Section 195"], "section": "195"}, {"id": "s9-1-vi", "kind": "section", "label": "Section 9(1)(vi)", "aliases": ["Section 9(1)(vi)"], "section": "9(1)(vi)"}, {"id": "india-ireland-dtaa-art12", "kind": "treaty", "label": "India-Ireland DTAA, Article 12", "aliases": ["India-Ireland DTAA", "India Ireland DTAA", "India-Ireland tax treaty", "India-Ireland treaty"]}, {"id": "engineering-analysis", "kind": "case", "label": "Engineering Analysis Centre of Excellence Pvt Ltd v. CIT (2021) 432 ITR 471 (SC)", "aliases": ["Engineering Analysis Centre of Excellence", "Engineering Analysis"]}], "expected_key_points": [{"point": "A right to use a copyrighted product without transfer of copyright is not royalty under the Act or the treaty", "source": "OP-18 s.6", "match_any": ["not\\s+(?:constitute\\s+|amount\\s+to\\s+|be\\s+)?(?:a\\s+)?royalt"]}, {"point": "The payments are business profits of the Irish company, not taxable in India absent a PE", "source": "OP-18 s.7", "match_any": ["business\\s+profits?"]}, {"point": "No withholding obligation under Section 195", "source": "OP-18 s.7", "match_any": ["(?:not|no)\\b.{0,60}(?:withh?old|deduct)"]}], "must_not_claim": [{"claim": "The payments constitute royalty", "patterns": ["(?:constitutes?|amounts?\\s+to|is|are|qualif(?:y|ies)\\s+as)\\s+(?:a\\s+)?(?:payment\\s+of\\s+)?royalt(?:y|ies)\\b"]}], "sources": ["tests/fixtures/opinions/OP-18_software_royalty_engineering_analysis.md"], "notes": "DRAFT from fictitious firm opinion OP-18 - expected position is that (fictitious) opinion's conclusion, not verified law. required_authorities = frontmatter authorities the opinion's Issue/Analysis/Conclusion actually relies on; frontmatter-only authorities are optional_authorities. A tax professional must confirm the position is correct law before setting verified=true.", "optional_authorities": [], "verified_by": "claude-draft", "verified": false}
{"id": "op19-ccd-interest-94b", "category": "computation", "answer_mode": "research", "question": "An Indian company issued INR 100 crore of compulsorily convertible debentures to its Singapore parent at an 11% annual coupon, mandatorily convertible into equity after 10 years. Annual interest is INR 11 crore and EBITDA is INR 60 crore. Is the coupon deductible as interest under Section 36(1)(iii), and does Section 94B restrict the deduction?", "required_authorities": [{"id": "s36-1-iii", "kind": "section", "label": "Section 36(1)(iii)", "aliases": ["Section 36(1)(iii)"], "section": "36(1)(iii)"}, {"id": "s94b", "kind": "section", "label": "Section 94B", "aliases": ["Section 94B"], "section": "94B"}], "optional_authorities": [{"id": "s2-28a", "kind": "section", "label": "Section 2(28A)", "aliases": ["Section 2(28A)"], "section": "2(28A)"}, {"id": "rajshree-sugars", "kind": "case", "label": "CIT v. Rajshree Sugars & Chemicals Ltd (Mad HC)", "aliases": ["Rajshree Sugars"]}], "expected_key_points": [{"point": "CCDs are debt for income-tax purposes until actual conversion, notwithstanding Ind AS 32", "source": "OP-19 s.6", "match_any": ["until\\s+(?:the\\s+)?(?:date\\s+of\\s+)?(?:actual\\s+)?conversion", "Ind\\s*AS\\s*32"]}, {"point": "Section 94B caps interest to a non-resident AE above INR 1 crore at 30% of EBITDA, i.e. INR 18 crore", "source": "OP-19 s.6", "match_any": ["18\\s*crore", "30\\s*%"]}, {"point": "Actual interest of INR 11 crore is within the cap, so no disallowance; full INR 11 crore deductible", "source": "OP-19 s.6-7", "match_any": ["no\\s+disallowance|fully\\s+deductible|full\\s+interest|entire\\s+interest"]}], "must_not_claim": [{"claim": "A disallowance arises", "patterns": ["disallowance\\s+of\\s+(?:inr|rs\\.?|₹)?\\s*\\d"]}, {"claim": "CCDs are equity for tax purposes", "patterns": ["(?:CCDs?|debentures)\\s+(?:are|is)\\s+(?:treated\\s+as\\s+)?equity\\s+for\\s+(?:income[\\s-]tax|tax)\\s+purposes"]}], "sources": ["tests/fixtures/opinions/OP-19_ccd_debt_classification_94B.md"], "notes": "DRAFT from fictitious firm opinion OP-19 - expected position is that (fictitious) opinion's conclusion, not verified law. required_authorities = frontmatter authorities the opinion's Issue/Analysis/Conclusion actually relies on; frontmatter-only authorities are optional_authorities. A tax professional must confirm the position is correct law before setting verified=true.", "verified_by": "claude-draft", "verified": false}
{"id": "op20-72a-amalgamation-losses", "category": "opinion", "answer_mode": "opinion", "question": "A company proposes to amalgamate into itself a loss-making pharmaceutical manufacturer with accumulated business losses of INR 22 crore and unabsorbed depreciation of INR 8 crore, under an NCLT-sanctioned scheme. It intends to continue the manufacturing business for at least five years and retain at least 75% of the acquired fixed assets for five years. Please advise whether those losses and depreciation can be carried forward and set off under Section 72A.", "required_authorities": [{"id": "s72a", "kind": "section", "label": "Section 72A", "aliases": ["Section 72A"], "section": "72A"}, {"id": "rule-9c", "kind": "rule", "label": "Rule 9C", "aliases": ["Rule 9C"]}], "optional_authorities": [{"id": "select-holiday-resorts", "kind": "case", "label": "CIT v. Select Holiday Resorts (P) Ltd (Del HC)", "aliases": ["Select Holiday Resorts"]}, {"id": "indo-rama", "kind": "case", "label": "Indo Rama Synthetics (I) Ltd v. CIT (2011) 330 ITR 363 (Del)", "aliases": ["Indo Rama Synthetics", "Indo Rama"]}], "expected_key_points": [{"point": "The amalgamating company owns an industrial undertaking (pharmaceutical manufacturing), meeting Section 72A eligibility", "source": "OP-20 s.6", "match_any": ["industrial\\s+undertaking"]}, {"point": "Rule 9C: retain at least 75% of the book value of fixed assets for 5 years, continue the business for 5 years, reach at least 50% of installed capacity by the end of the 4th year", "source": "OP-20 s.6", "match_any": ["installed\\s+capacity", "75\\s*%"]}, {"point": "Losses of INR 22 crore and unabsorbed depreciation of INR 8 crore are available as the amalgamated company's own, subject to continuing Rule 9C compliance", "source": "OP-20 s.7", "match_any": ["22\\s*crore", "8\\s*crore"]}, {"point": "Non-compliance in a later year makes the set-off already claimed taxable as income in the year of default", "source": "OP-20 s.6", "match_any": ["year\\s+(?:of|in\\s+which).{0,30}(?:default|non[\\s-]compliance|fail)"]}], "must_not_claim": [{"claim": "The losses lapse on amalgamation", "patterns": ["losses\\s+(?:will|would|shall)\\s+lapse"]}], "sources": ["tests/fixtures/opinions/OP-20_carry_forward_losses_amalgamation_72A.md"], "notes": "DRAFT from fictitious firm opinion OP-20 - expected position is that (fictitious) opinion's conclusion, not verified law. required_authorities = frontmatter authorities the opinion's Issue/Analysis/Conclusion actually relies on; frontmatter-only authorities are optional_authorities. A tax professional must confirm the position is correct law before setting verified=true.", "verified_by": "claude-draft", "verified": false}

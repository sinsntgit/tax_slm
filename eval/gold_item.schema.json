{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eval/gold_item.schema.json",
  "title": "Tax research gold item",
  "description": "One line of eval/gold/*.jsonl. 2026-10-14: validated by eval/goldset.py (a small built-in validator for the subset of JSON Schema used here - no jsonschema dependency).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "question", "category", "answer_mode", "required_authorities", "expected_key_points", "must_not_claim", "verified_by", "verified", "notes"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,80}$"},
    "question": {"type": "string", "minLength": 15},
    "category": {"type": "string", "enum": ["lookup", "research", "for_against", "change_in_law", "treaty", "computation", "opinion"]},
    "answer_mode": {"type": "string", "enum": ["lookup", "research", "opinion"]},
    "retrieval_mode": {"type": "string", "enum": ["hybrid", "vector_only", "semantic_graph", "agentic", "structured_research"]},
    "required_authorities": {
      "type": "array",
      "items": {"$ref": "#/$defs/authority"}
    },
    "optional_authorities": {
      "type": "array",
      "items": {"$ref": "#/$defs/authority"}
    },
    "expected_key_points": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["point", "source"],
        "properties": {
          "point": {"type": "string", "minLength": 5},
          "source": {"type": "string", "minLength": 5},
          "match_any": {"type": "array", "items": {"type": "string", "format": "regex", "minLength": 2}}
        }
      }
    },
    "must_not_claim": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "patterns"],
        "properties": {
          "claim": {"type": "string", "minLength": 5},
          "patterns": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "regex", "minLength": 3}},
          "negation_guard": {"type": "boolean"}
        }
      }
    },
    "sources": {"type": "array", "items": {"type": "string", "minLength": 3}},
    "verified_by": {"type": "string", "minLength": 2},
    "verified": {"type": "boolean"},
    "verified_at": {"type": "string"},
    "notes": {"type": "string"}
  },
  "$defs": {
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label", "aliases"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "kind": {"type": "string", "enum": ["section", "rule", "case", "treaty", "circular", "notification", "other"]},
        "label": {"type": "string", "minLength": 2},
        "aliases": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
        "section": {"type": "string", "pattern": "^[0-9]+[A-Za-z-]*(\\([0-9A-Za-z]+\\))*$"}
      }
    }
  }
}

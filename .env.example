# Copy this file to .env and fill in real values. Never commit .env itself.

# --- LLM provider (framework/core/infra/llm_client.py) ----------------------
# USE_MODEL picks the provider: CLAUDE, GEMINI, GPT, or LOCAL (self-hosted). Re-read from .env on
# EVERY LLM call (framework.core.infra.llm_client.refresh_model_config()),
# so editing this file while the app/an ingestion run is already going takes
# effect on the very next LLM call - no restart needed, including switching
# providers mid-run (as long as that provider's API key is also set below).
USE_MODEL=CLAUDE
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=120

# Optional: override the exact model string for the active provider. Blank
# (or unset) falls back to llm_client.MODEL_NAME_DEFAULTS - only set the one
# matching your USE_MODEL, but all three can be left ready to go so flipping
# USE_MODEL later doesn't need a second edit. Same live-reload as above.
CLAUDE_MODEL_NAME=claude-haiku-4-5-20251001
GEMINI_MODEL_NAME=gemini-1.5-flash
GPT_MODEL_NAME=gpt-5-nano

# Optional: use a DIFFERENT provider for ingestion (extraction) vs retrieval
# (/api/ask) - e.g. a cheap/fast model for bulk document ingestion, a
# stronger one for user-facing answers. Blank/unset falls back to plain
# USE_MODEL above for that purpose. Same live-reload as everything above.
USE_MODEL_INGESTION=CLAUDE
USE_MODEL_RETRIEVAL=CLAUDE

# Optional: even when ingestion/retrieval use the SAME provider, override
# just the MODEL NAME per purpose (checked before the plain <PROVIDER>_
# MODEL_NAME above). Recommended cost/accuracy split for Claude: Haiku 4.5
# for bulk ingestion (cheap, fast, plenty accurate for structured
# extraction), Sonnet 5 for user-facing retrieval answers (stronger
# reasoning/citation accuracy, still much cheaper than Opus).
CLAUDE_MODEL_NAME_INGESTION=claude-haiku-4-5-20251001
CLAUDE_MODEL_NAME_RETRIEVAL=claude-sonnet-5

# --- Local / self-hosted model (USE_MODEL=LOCAL) - optional -----------------
# Any OpenAI-compatible server: vLLM, Ollama, LM Studio. Base URL must include
# /v1. LOCAL_MODEL_NAME must equal the server's served model name (vLLM
# --served-model-name); blank = use the first model the server lists at
# /v1/models. LOCAL_LLM_API_KEY only if the server was started with --api-key
# (the real OPENAI_API_KEY is never sent to the local server). Same live
# reload as everything above. See README "Running with a local model".
LOCAL_LLM_BASE_URL=
LOCAL_MODEL_NAME=
LOCAL_LLM_API_KEY=
# Hard cap on output tokens per call (callers ask for up to 5000).
LOCAL_LLM_MAX_TOKENS=
# The server's context window (vLLM --max-model-len); output tokens are
# reduced so prompt + output fits instead of the server rejecting the call.
LOCAL_LLM_CONTEXT_LENGTH=
# Retries on connection errors/timeouts (openai SDK); 0 = fail fast.
LOCAL_LLM_MAX_RETRIES=1
# blank/auto = try a system message, fall back to prepending it to the user
# message if the chat template rejects it (Gemma etc.); 0 = always prepend.
LOCAL_LLM_SYSTEM_ROLE=
# Strip a leading <think>...</think> block (Qwen3 / R1-style models). 1 = on.
LOCAL_LLM_STRIP_THINK=1

# --- Per-call routing (gradual SLM rollout) - optional -----------------------
# LLM_ROUTE_<CALL_NAME>=<CLAUDE|GEMINI|GPT|LOCAL> sends ONE named call to a
# provider, overriding USE_MODEL_<PURPOSE> and USE_MODEL (precedence: call
# route > purpose > global). Optional LLM_ROUTE_<CALL_NAME>_MODEL=<model>
# overrides the model name too (e.g. a per-task vLLM LoRA adapter). Matching
# is longest-prefix on _-separated segments, so LLM_ROUTE_CASE_LAW_EXTRACTION
# covers every case_law_extraction_<file> call. To un-route while running,
# set the value BLANK (deleting the line is not picked up until restart).
# Call names - retrieval: answer_generation, answer_generation_retry,
#   intent_detection, nl2cypher, retrieval_plan, evidence_sufficiency,
#   case_law_classification, tribunal_bucketing, fact_sheet_extraction,
#   agent_routing, agent_merge, hierarchical_synthesis, structured_data_query,
#   answer_evaluation, answer_evaluation_general_knowledge,
#   answer_quality_judge, document_qa, opinion_generation
# Call names - ingestion: case_law_extraction_<file>, circular_extraction_<file>,
#   treaty_preamble_<file>, semantic_layer_group_<i>_of_<n>,
#   enrichment_group_<i>_of_<n>, temporal_metadata,
#   act_correspondence_tier1, act_correspondence_tier2
LLM_ROUTE_NL2CYPHER=
LLM_ROUTE_NL2CYPHER_MODEL=
LLM_ROUTE_INTENT_DETECTION=
# Judge model: when evaluating the SLM, route the judge/evaluator calls to a
# fixed reference model so the model under test never grades itself (see
# README "Judge model"). Blank = judges use the retrieval model (as before).
# ANSWER_EVALUATION also covers answer_evaluation_general_knowledge. Never use
# LLM_ROUTE_ANSWER - by prefix it would also route answer_generation.
LLM_ROUTE_ANSWER_QUALITY_JUDGE=
LLM_ROUTE_ANSWER_QUALITY_JUDGE_MODEL=
LLM_ROUTE_ANSWER_EVALUATION=
LLM_ROUTE_ANSWER_EVALUATION_MODEL=

# --- Training-data capture (framework/core/infra/llm_call_log.py) -----------
# WARNING: when on, EVERY LLM call's full prompt and answer (client questions,
# uploaded documents, opinions) is written to disk. Off by default. PAN/
# Aadhaar/e-mail/phone are regex-masked, names/facts are NOT. Keep the files
# inside the customer environment; data/ is gitignored. Export with
# `python -m framework.cli.export_training_data --out <dir>`.
LLM_CALL_LOG=0
LLM_CALL_LOG_DIR=
# 1 (default) = mask PII and refuse to write if the masker can't load.
# 0 only for synthetic/public data.
LLM_CALL_LOG_PII_MASK=1

# --- Neo4j (framework/core/infra/neo4j_client.py) ----------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me   # must match NEO4J_AUTH in docker-compose.yml
NEO4J_DATABASE=neo4j
NEO4J_CONNECT_TIMEOUT_SECONDS=10
NEO4J_STATEMENT_TIMEOUT_SECONDS=20

# --- Redis (framework/core/retrieve/cache.py) --------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_TTL_SECONDS=3600

# --- Embeddings / reranking ---------------------------------------------------
# law-ai/InLegalBERT (Indian legal text, 768-dim) - domain-specific upgrade
# over the generic all-MiniLM-L6-v2 default (384-dim). After changing this,
# run `python -m framework.cli.reembed_all_chunks --domain tax` ONCE to
# re-embed every existing Chunk node at the new dimension.
EMBEDDING_MODEL_NAME=law-ai/InLegalBERT
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
# Minimum post-sigmoid relevance (0-1) a reranked chunk must clear to be
# handed to the LLM for answer generation at full confidence. 0.85 proved too
# strict in practice (bge-reranker-base under-scores paraphrased/conceptual
# questions vs near-verbatim ones, even against genuinely relevant text) -
# recalibrated down to 0.55.
RERANK_MIN_RELEVANCE=0.55
# Lower bar used ONLY when nothing clears RERANK_MIN_RELEVANCE - lets a
# decent-but-not-excellent match still reach the LLM (tagged
# relevance_tier="fallback", lower reported confidence) instead of the
# pipeline flatly refusing to answer.
RERANK_FALLBACK_RELEVANCE=0.35
RERANK_FALLBACK_MAX_CHUNKS=5

# --- tiktoken (domain_packs/tax/converters/chunking.py) - offline installs ----
# Token counting downloads the cl100k_base BPE file on first use. On an
# air-gapped machine pre-seed a cache folder (README "Offline / air-gapped
# installs") and point TIKTOKEN_CACHE_DIR at it; TIKTOKEN_OFFLINE=1 never tries
# the network. On failure/timeout counts fall back to ~4 chars/token.
# TIKTOKEN_CACHE_DIR=D:\tax_slm\tiktoken_cache
TIKTOKEN_OFFLINE=0
TIKTOKEN_LOAD_TIMEOUT_SECONDS=10

# --- Observability (framework/core/retrieve/observability.py) - optional -----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- PII masking (framework/core/retrieve/pii.py) - set a real secret in .env
PII_MASK_SALT=change-me-to-a-long-random-string

# --- Poppler (framework/core/convert/poppler_utils.py) - only needed on
# systems where pdftohtml/pdftotext aren't already on PATH (common on Windows)
POPPLER_BIN_DIR=

# --- Which domain pack the webapp/CLI load by default -------------------------
FRAMEWORK_DOMAIN=tax

# Copy this file to .env and fill in real values. Never commit .env itself.

# --- LLM provider (framework/core/infra/llm_client.py) ----------------------
# USE_MODEL picks the provider: CLAUDE, GEMINI, or GPT. Re-read from .env on
# EVERY LLM call (framework.core.infra.llm_client.refresh_model_config()),
# so editing this file while the app/an ingestion run is already going takes
# effect on the very next LLM call - no restart needed, including switching
# providers mid-run (as long as that provider's API key is also set below).
USE_MODEL=CLAUDE
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=120

# Optional: override the exact model string for the active provider. Blank
# (or unset) falls back to llm_client.MODEL_NAME_DEFAULTS - only set the one
# matching your USE_MODEL, but all three can be left ready to go so flipping
# USE_MODEL later doesn't need a second edit. Same live-reload as above.
CLAUDE_MODEL_NAME=claude-haiku-4-5-20251001
GEMINI_MODEL_NAME=gemini-1.5-flash
GPT_MODEL_NAME=gpt-5-nano

# Optional: use a DIFFERENT provider for ingestion (extraction) vs retrieval
# (/api/ask) - e.g. a cheap/fast model for bulk document ingestion, a
# stronger one for user-facing answers. Blank/unset falls back to plain
# USE_MODEL above for that purpose. Same live-reload as everything above.
USE_MODEL_INGESTION=CLAUDE
USE_MODEL_RETRIEVAL=CLAUDE

# Optional: even when ingestion/retrieval use the SAME provider, override
# just the MODEL NAME per purpose (checked before the plain <PROVIDER>_
# MODEL_NAME above). Recommended cost/accuracy split for Claude: Haiku 4.5
# for bulk ingestion (cheap, fast, plenty accurate for structured
# extraction), Sonnet 5 for user-facing retrieval answers (stronger
# reasoning/citation accuracy, still much cheaper than Opus).
CLAUDE_MODEL_NAME_INGESTION=claude-haiku-4-5-20251001
CLAUDE_MODEL_NAME_RETRIEVAL=claude-sonnet-5

# --- Neo4j (framework/core/infra/neo4j_client.py) ----------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me   # must match NEO4J_AUTH in docker-compose.yml
NEO4J_DATABASE=neo4j
NEO4J_CONNECT_TIMEOUT_SECONDS=10
NEO4J_STATEMENT_TIMEOUT_SECONDS=20

# --- Redis (framework/core/retrieve/cache.py) --------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_TTL_SECONDS=3600

# --- Embeddings / reranking ---------------------------------------------------
# law-ai/InLegalBERT (Indian legal text, 768-dim) - domain-specific upgrade
# over the generic all-MiniLM-L6-v2 default (384-dim). After changing this,
# run `python -m framework.cli.reembed_all_chunks --domain tax` ONCE to
# re-embed every existing Chunk node at the new dimension.
EMBEDDING_MODEL_NAME=law-ai/InLegalBERT
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
# Minimum post-sigmoid relevance (0-1) a reranked chunk must clear to be
# handed to the LLM for answer generation at full confidence. 0.85 proved too
# strict in practice (bge-reranker-base under-scores paraphrased/conceptual
# questions vs near-verbatim ones, even against genuinely relevant text) -
# recalibrated down to 0.55.
RERANK_MIN_RELEVANCE=0.55
# Lower bar used ONLY when nothing clears RERANK_MIN_RELEVANCE - lets a
# decent-but-not-excellent match still reach the LLM (tagged
# relevance_tier="fallback", lower reported confidence) instead of the
# pipeline flatly refusing to answer.
RERANK_FALLBACK_RELEVANCE=0.35
RERANK_FALLBACK_MAX_CHUNKS=5

# --- Observability (framework/core/retrieve/observability.py) - optional -----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- PII masking (framework/core/retrieve/pii.py) - set a real secret in .env
PII_MASK_SALT=change-me-to-a-long-random-string

# --- Poppler (framework/core/convert/poppler_utils.py) - only needed on
# systems where pdftohtml/pdftotext aren't already on PATH (common on Windows)
POPPLER_BIN_DIR=

# --- Which domain pack the webapp/CLI load by default -------------------------
FRAMEWORK_DOMAIN=tax
